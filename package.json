{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/web",
    "artifacts/api-server",
    "lib/api-zod",
    "lib/api-client-react",
    "lib/db"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=artifacts/web",
    "build": "npm run build --workspace=artifacts/web && npm run build --workspace=artifacts/api-server",
    "start": "npm run start --workspace=artifacts/web",
    "lint": "npm run typecheck",
    "typecheck": "tsc --build && npm run typecheck --workspace=artifacts/web && npm run typecheck --workspace=artifacts/api-server"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.6.1",
    "@types/leaflet": "^1.9.22",
    "eslint": "^10.15.0",
    "firebase": "^13.4.0",
    "framer-motion": "^14.14.0",
    "leaflet": "^1.9.4"
  }
}